      "updated": 1794924886789,
      "link": null,
      "locked": false,
      "text": "Session B\nCALL sp_hold_seats(... seat 4 ...)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "inGtJ1kk8QIdaFydw5nSf",
