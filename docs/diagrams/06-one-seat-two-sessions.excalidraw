      "boundElements": null,
      "updated": 1794924886786,
      "link": null,
      "locked": false,
      "text": "Payment uses the same idea with row locks: SELECT ... FOR UPDATE on the booking makes two payments of one booking take turns.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Payment uses the same idea with row locks: SELECT ... FOR UPDATE on the booking makes two payments of one booking take turns.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ZY2jHTI5Vwi7ICgNoCXU7",
      "type": "text",
      "x": 189.0185546875,
      "y": 92.5,
      "width": 241.962890625,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 808905400,
      "version": 3,
      "versionNonce": 182812856,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794924886789,
      "link": null,
      "locked": false,
      "text": "Session A\nCALL sp_hold_seats(... seat 4 ...)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "nh-kX0lwC8Jl1BqtPhZnm",
      "originalText": "Session A\nCALL sp_hold_seats(... seat 4 ...)",
      "autoResize": true,
      "lineHeight": 1.25
    },
