    },
    {
      "id": "pKBDSsS8mekspXPilgWYK",
      "type": "text",
      "x": 409.02783203125,
      "y": 271.25,
      "width": 461.9443359375,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 43359416,
      "version": 3,
      "versionNonce": 1692707256,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794924886789,
      "link": null,
      "locked": false,
      "text": "INSERT INTO ticket (branch, theatre, date, time, seat, booking)\nprimary key = those five columns,\nso only one row for this seat can exist",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "u7Db2YXcwY-A0O7nJe7og",
      "originalText": "INSERT INTO ticket (branch, theatre, date, time, seat, booking)\nprimary key = those five columns,\nso only one row for this seat can exist",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NdD9Z5cLGyhujfqawYC4M",
      "type": "text",
      "x": 199.7880859375,
      "y": 486.25,
      "width": 280.423828125,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#15803d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aG",
      "roundness": null,
      "seed": 674317752,
      "version": 3,
      "versionNonce": 1214115272,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794924886789,
      "link": null,
      "locked": false,
      "text": "A gets there first:\nticket row created, booking PENDING\n(seat held for 15 minutes)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "wjnsC9bHIzOt1MpB6My_d",
      "originalText": "A gets there first:\nticket row created, booking PENDING\n(seat held for 15 minutes)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wpl69Y1gO0we6a1_4O8Ef",
      "type": "text",
      "x": 808.029296875,
      "y": 490,
      "width": 293.94140625,
      "height": 90,
      "angle": 0,
      "strokeColor": "#b91c1c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aH",
      "roundness": null,
      "seed": 1315950264,
      "version": 3,
      "versionNonce": 1729540792,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794924886789,
      "link": null,
      "locked": false,
      "text": "B finds the key taken:\nduplicate key becomes the message\n'Seat already taken for this showtime'\nthe whole call is undone, no booking left",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "q7qMIEep3rr32isMtZB7r",
      "originalText": "B finds the key taken:\nduplicate key becomes the message\n'Seat already taken for this showtime'\nthe whole call is undone, no booking left",
      "autoResize": true,
      "lineHeight": 1.25
    },
